# Copy this file to .env and fill in your keys.

# Required: Nebius Token Factory key (https://tokenfactory.nebius.com -> API keys)
NEBIUS_API_KEY=

# Optional but recommended: Tavily key for grounding AGENTS.md in official docs (https://tavily.com)
TAVILY_API_KEY=

# Nemotron model per role. If an ID is not served, AgentReady picks the closest
# Nemotron model from Token Factory's /v1/models list. Check with: python -m agentready models
# AGENTREADY_MODEL_NANO=nvidia/nemotron-3-nano-30b-a3b
# AGENTREADY_MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
# AGENTREADY_MODEL_ULTRA=nvidia/nemotron-3-ultra

# Optional JSON merged into every chat request, e.g. to turn Nemotron reasoning traces off
# if your endpoint supports it (check Token Factory docs for the exact parameter):
# AGENTREADY_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}

# Optional prices to show $ cost: "input,output" in USD per 1M tokens (copy from the Token Factory price list)
# AGENTREADY_PRICE_SUPER=0.0,0.0

# Where agent commands run: local | docker | nebius
AGENTREADY_EXECUTOR=local

# Nebius Serverless Jobs executor (only for AGENTREADY_EXECUTOR=nebius)
# AGENTREADY_NEBIUS_IMAGE=ghcr.io/<you>/agentready:latest
# AGENTREADY_NEBIUS_PLATFORM=cpu-e1
# AGENTREADY_NEBIUS_PRESET=2vcpu-8gb
# AGENTREADY_NEBIUS_KEY_SECRET=<MysteryBox secret selector for NEBIUS_API_KEY>

# Hosted demo hardening (used on the Nebius Serverless Endpoint)
# AGENTREADY_PUBLIC_DEMO=1
# AGENTREADY_ACCESS_TOKEN=<token you give to judges to start runs>
