  "launch_handler": {"client_mode": ["navigate-existing", "auto"]},
  "icons": [
    {"src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any"},
    {"src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any"},
    {"src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "shortcuts": [
    {"name": "Test a repo", "short_name": "Test", "url": "/?focus=1", "icons": [{"src": "/icon-192.png", "sizes": "192x192"}]},
    {"name": "Verify code an AI wrote", "short_name": "Verify", "url": "/verify", "icons": [{"src": "/icon-192.png", "sizes": "192x192"}]},
    {"name": "History", "url": "/history", "icons": [{"src": "/icon-192.png", "sizes": "192x192"}]}
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "params": {"title": "title", "text": "text", "url": "url"}
  }
